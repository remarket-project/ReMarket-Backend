# ─── Database ───
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=remarket
POSTGRES_PASSWORD=change-this-strong-password-32chars
POSTGRES_DB=remarket

# ─── API ───
API_V1_STR=/api/v1
SECRET_KEY=your-super-secret-key-change-this-in-production-64chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ─── Project ───
PROJECT_NAME=ReMarket
ENVIRONMENT=local

# ─── CORS ───
# Development:
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Production (thay bằng domain thật):
# BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ─── Frontend / Backend URLs (quan trọng cho email links) ───
FRONTEND_HOST=http://localhost:5173
# Production: FRONTEND_HOST=https://yourdomain.com
BACKEND_HOST=http://localhost:8000
# Production: BACKEND_HOST=https://yourdomain.com

# ─── Email (Gmail SMTP) ───
# Cách tạo App Password: https://myaccount.google.com/apppasswords (cần bật 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-16-chars
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=ReMarket
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ─── GHN Shipping ───
SHIPPING_PROVIDER=ghn
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=200514
GHN_FROM_PROVINCE_ID=201
GHN_FROM_DISTRICT_ID=1485
GHN_FROM_WARD_CODE=
GHN_FROM_PHONE=0900000000

# ─── Stripe (Test Mode) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
VND_USD_EXCHANGE_RATE=26000

# ─── MinIO ───
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
# Local development (POSTGRES_SERVER=localhost → MINIO_ENDPOINT=localhost:9000):
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=listings
MINIO_USE_SSL=false
# URL công khai để trình duyệt truy cập ảnh:
# Development:
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Production (dùng domain thật):
# MINIO_PUBLIC_ENDPOINT=https://yourdomain.com/uploads

# ─── AI Settings ───
GEMINI_API_KEYS=["your-gemini-key-1","your-gemini-key-2"]
GEMINI_API_KEY=your-gemini-key-1
AI_PROVIDER=local
GEMINI_CHAT_MODELS=["gemini-2.0-flash","gemini-2.0-flash-lite"]
GEMINI_RPD_LIMITS={"gemini-2.0-flash":1500,"gemini-2.0-flash-lite":1500}
GEMINI_RPD_WARN_THRESHOLD=0.85
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-small
AI_EMBED_DIM=384
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30

# ─── 9Router (AI Moderation + Chatbot) ───
# Local development:
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# Docker (tự động override bởi docker-compose.prod.yml):
# NINE_ROUTER_BASE_URL=http://9router:20128/v1
NINE_ROUTER_API_KEY=your-9router-api-key
NINE_ROUTER_PASSWORD=change-this-password
NINE_ROUTER_CHAT_MODEL=ReMarket_chatbot
AI_MODERATION_ENABLED=true
AI_MODERATION_MODELS=["oc/mimo-v2.5-free","oc/deepseek-v4-flash-free"]

# ─── Admin ───
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=Admin@123ChangeThis!

# ─── Redis (optional) ───
# REDIS_URL=redis://redis:6379/0

# ─── Simulation (giả lập giao hàng) ───
SIMULATION_PENDING_TO_SHIPPING_SECONDS=30
SIMULATION_SHIPPING_TO_DELIVERED_SECONDS=60
SIMULATION_CHECK_INTERVAL_SECONDS=5

# ─── Order Auto-Complete ───
ORDER_AUTO_COMPLETE_HOURS=48
ORDER_AUTO_CANCEL_HOURS=24

# ─── Offer Settings ───
OFFER_EXPIRE_HOURS=48
OFFER_CONFIRM_HOURS=24
